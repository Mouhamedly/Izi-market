# =========================================================
# IZI Market — Configuration des Variables d'Environnement
# =========================================================

# 1. Supabase (Base de données, Auth & Realtime)
# Obtenez ces valeurs sur https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Anthropic (Claude AI - Intelligence commerciale)
# Obtenez votre clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# 3. Meta WhatsApp Cloud API (Webhook & Messages)
# Obtenez ces valeurs sur https://developers.facebook.com/apps/
WHATSAPP_VERIFY_TOKEN=izi_market_secure_webhook_token_2025
WHATSAPP_APP_SECRET=your_app_secret_here

# 4. URL de l'application (en local ou Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
